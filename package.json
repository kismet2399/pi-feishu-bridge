{
  "name": "@kismet2496/pi-feishu-bridge",
  "version": "0.5.0",
  "description": "Pi/Lark bridge (fork of ax-feishu-bridge) — Feishu WebSocket channel with CardKit streaming, maintained with local fixes",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi",
    "dsh",
    "feishu",
    "lark",
    "extension"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-attachment-local": "^0.1.0-rc.7",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "^0.1.0-rc.6",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./pi": "./src/adapters/pi/index.ts",
    "./harness": "./lib/adapters/harness/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "lib",
    ".pi",
    "cordis.patch.yml",
    "tsconfig.build.json",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/feishu/index.ts"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json || true",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --experimental-transform-types --import ./test/register.mjs --test test/*.test.mjs test/*.test.ts",
    "build:strict": "tsc -p tsconfig.build.json"
  },
  "author": "kismet"
}
